#!/bin/bash

SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
COMMANDS_DIR="$SCRIPT_DIR/commands"

get_description() {
    local COMMAND="$1"
    "$COMMAND" --description 2>/dev/null
}

show_help() {
    echo "Usage: pine <command>"
    echo
    echo "Available commands:"

    for COMMAND in "$COMMANDS_DIR"/*; do
        [ -f "$COMMAND" ] || continue

        NAME="$(basename "$COMMAND")"
        DESCRIPTION="$(get_description "$COMMAND")"

        printf "  %-10s %s\n" "$NAME" "$DESCRIPTION"
    done
}

if [ $# -eq 0 ]; then
    echo "Incomplete command."
    echo
    show_help
    exit 1
fi

if [ "$1" = "help" ]; then
    show_help
    exit 0
fi

COMMAND="$COMMANDS_DIR/$1"
shift

if [ -x "$COMMAND" ]; then
    exec "$COMMAND" "$@"
else
    echo "Incorrect command."
    echo
    show_help
    exit 1
fi
