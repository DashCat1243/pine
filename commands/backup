#!/bin/bash

if [ "$1" = "--description" ]; then
    echo "Back up important home folders"
    exit 0
fi

if [ "$1" = "--help" ]; then
    echo "Usage: pine backup"
    echo
    echo "Mounts the Pineapple backup drive and uses rsync to back up Desktop, Downloads, Documents, Pictures, Videos, Music, and .config while showing transfer progress and backup statistics."
    exit 0
fi

set -euo pipefail

BACKUP_UUID="940720d3-869c-496e-b608-37f4e32870e5"
MOUNTPOINT="/mnt/pineapple-backup"
BACKUP_DIR="$MOUNTPOINT/home/$USER"

echo "Mounting backup drive..."

if ! mountpoint -q "$MOUNTPOINT"; then
    sudo mount "UUID=$BACKUP_UUID" "$MOUNTPOINT"
fi

mkdir -p "$BACKUP_DIR"

echo
echo "Backing up home folders..."
echo

TOTAL_TRANSFERRED=0
BACKUP_START=$(date +%s%N)

for DIR in Desktop Downloads Documents Pictures Videos Music .config; do
    echo "→ $DIR"

    LOG=$(mktemp)

    rsync \
        -a \
        --info=progress2 \
        --log-file="$LOG" \
        --log-file-format='%b' \
        "$HOME/$DIR/" \
        "$BACKUP_DIR/$DIR/"

    TRANSFERRED=$(awk '$4 ~ /^[0-9]+$/ { total += $4 } END { print total + 0 }' "$LOG")

    TOTAL_TRANSFERRED=$((TOTAL_TRANSFERRED + TRANSFERRED))

    rm -f "$LOG"

    echo
done

BACKUP_END=$(date +%s%N)
ELAPSED_NS=$((BACKUP_END - BACKUP_START))

echo "Backup complete."
echo

echo "Total data transferred: $(numfmt --to=iec-i --suffix=B "$TOTAL_TRANSFERRED")"

if [ "$TOTAL_TRANSFERRED" -gt 0 ] && [ "$ELAPSED_NS" -gt 0 ]; then
    SPEED=$(awk \
        -v bytes="$TOTAL_TRANSFERRED" \
        -v ns="$ELAPSED_NS" \
        'BEGIN {
            printf "%.2f MB/s", bytes / (ns / 1000000000) / 1000000
        }')

    echo "Average transfer speed: $SPEED"
else
    echo "Average transfer speed: 0.00 MB/s"
fi
