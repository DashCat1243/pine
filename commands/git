#!/bin/bash

if [ "$1" = "--description" ]; then
    echo "Commit and push repository changes"
    exit 0
fi

if [ "$1" = "--help" ]; then
    echo "Usage: pine git"
    echo
    echo "Checks the current Git repository for changes, shows the current status, asks for a commit message, stages all changes, creates a commit, and pushes the commit to the configured remote repository."
    exit 0
fi

set -e

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "This directory is not a Git repository."
    exit 1
fi

cd "$(git rev-parse --show-toplevel)"

echo "Checking for changes..."
echo

git status --short

if [ -z "$(git status --porcelain)" ]; then
    echo
    echo "Nothing to commit."
    exit 0
fi

echo
read -rp "Commit message: " MESSAGE

if [ -z "$MESSAGE" ]; then
    echo "No commit message entered."
    exit 1
fi

echo
echo "Staging changes..."
git add -A

echo
echo "Committing..."
git commit -m "$MESSAGE"

echo
echo "Pushing to GitHub..."
git push

echo
echo "Done."
