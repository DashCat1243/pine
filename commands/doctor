#!/bin/bash

if [ "$1" = "--description" ]; then
    echo "Check Pine and its dependencies"
    exit 0
fi

if [ "$1" = "--help" ]; then
    echo "Usage: pine doctor"
    echo
    echo "Checks that Pine is correctly installed and that its Git repository, GitHub connection, SSH authentication, backup drive, and required programs are available."
    exit 0
fi

echo "Pine doctor"
echo

PASS=0
FAIL=0

check() {
    local NAME="$1"
    local COMMAND="$2"

    if eval "$COMMAND" >/dev/null 2>&1; then
        echo "✓ $NAME"
        ((PASS++))
    else
        echo "✗ $NAME"
        ((FAIL++))
    fi
}

check "Commands directory" \
    "[ -d \"$HOME/Projects/pine/commands\" ]"

check "Git repository" \
    "git -C \"$HOME/Projects/pine\" rev-parse --is-inside-work-tree"

check "GitHub remote" \
    "git -C \"$HOME/Projects/pine\" remote get-url origin"

if ssh -T git@github.com 2>&1 | grep -q "successfully authenticated"; then
    echo "✓ SSH authentication"
    ((PASS++))
else
    echo "✗ SSH authentication"
    ((FAIL++))
fi

check "Backup drive" \
    "mountpoint -q /mnt/pineapple-backup"

check "rsync" \
    "command -v rsync"

check "curl" \
    "command -v curl"

echo
echo "$PASS checks passed, $FAIL failed."

if [ "$FAIL" -eq 0 ]; then
    echo "Everything looks good."
    exit 0
else
    echo "Something needs attention."
    exit 1
fi
