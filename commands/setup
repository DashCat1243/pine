#!/bin/bash

if [ "$1" = "--description" ]; then
    echo "Set up Pine on this system"
    exit 0
fi

if [ "$1" = "--help" ]; then
    echo "Usage: pine setup"
    echo
    echo "Installs Pine's command symlink, Bash completion, and shell integration, and prepares the repository for use on this system."
    exit 0
fi

SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
PINE_DIR="$(dirname "$SCRIPT_DIR")"
PINE_EXEC="$PINE_DIR/pine"

INSTALL_DIR="$HOME/.local/bin"
INSTALL_PATH="$INSTALL_DIR/pine"

COMPLETIONS_DIR="${BASH_COMPLETION_USER_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion}/completions"
COMPLETION_PATH="$COMPLETIONS_DIR/pine"
COMPLETION_SOURCE="$PINE_DIR/completions/pine"

SHELL_CONFIG_DIR="$HOME/.config/pine"
SHELL_FUNCTION="$SHELL_CONFIG_DIR/pine.bash"
SHELL_SOURCE="$PINE_DIR/shell/pine.bash"

BASHRC="$HOME/.bashrc"

echo "Setting up Pine..."
echo

if [ ! -f "$PINE_EXEC" ]; then
    echo "Could not find Pine at:"
    echo "$PINE_EXEC"
    exit 1
fi

echo "Making Pine executable..."
chmod +x "$PINE_EXEC"

echo "Making Pine commands executable..."
find "$PINE_DIR/commands" -type f -exec chmod +x {} +

echo "Checking Pine command..."

mkdir -p "$INSTALL_DIR"

if [ -L "$INSTALL_PATH" ]; then
    CURRENT_TARGET="$(readlink -f "$INSTALL_PATH")"

    if [ "$CURRENT_TARGET" = "$PINE_EXEC" ]; then
        echo "  ✓ Pine command already set up."
    else
        echo "  Updating Pine command..."
        rm "$INSTALL_PATH"
        ln -s "$PINE_EXEC" "$INSTALL_PATH"
    fi
elif [ -e "$INSTALL_PATH" ]; then
    echo
    echo "A non-symlink already exists at:"
    echo "$INSTALL_PATH"
    echo
    echo "Refusing to overwrite it."
    exit 1
else
    ln -s "$PINE_EXEC" "$INSTALL_PATH"
    echo "  ✓ Pine command installed."
fi

echo
echo "Checking Bash completion..."

mkdir -p "$COMPLETIONS_DIR"

if [ -L "$COMPLETION_PATH" ]; then
    CURRENT_TARGET="$(readlink -f "$COMPLETION_PATH")"

    if [ "$CURRENT_TARGET" = "$COMPLETION_SOURCE" ]; then
        echo "  ✓ Bash completion already installed."
    else
        echo "  Updating Bash completion..."
        rm "$COMPLETION_PATH"
        ln -s "$COMPLETION_SOURCE" "$COMPLETION_PATH"
    fi
elif [ -e "$COMPLETION_PATH" ]; then
    echo
    echo "A non-symlink already exists at:"
    echo "$COMPLETION_PATH"
    echo
    echo "Refusing to overwrite it."
    exit 1
else
    ln -s "$COMPLETION_SOURCE" "$COMPLETION_PATH"
    echo "  ✓ Bash completion installed."
fi

echo
echo "Checking Bash integration..."

mkdir -p "$SHELL_CONFIG_DIR"

if [ -L "$SHELL_FUNCTION" ]; then
    CURRENT_TARGET="$(readlink -f "$SHELL_FUNCTION")"

    if [ "$CURRENT_TARGET" = "$SHELL_SOURCE" ]; then
        echo "  ✓ Bash integration already installed."
    else
        echo "  Updating Bash integration..."
        rm "$SHELL_FUNCTION"
        ln -s "$SHELL_SOURCE" "$SHELL_FUNCTION"
    fi
elif [ -e "$SHELL_FUNCTION" ]; then
    echo
    echo "A non-symlink already exists at:"
    echo "$SHELL_FUNCTION"
    echo
    echo "Refusing to overwrite it."
    exit 1
else
    ln -s "$SHELL_SOURCE" "$SHELL_FUNCTION"
    echo "  ✓ Bash integration installed."
fi

echo
echo "Checking ~/.bashrc..."

SOURCE_LINE='source "$HOME/.config/pine/pine.bash"'

if grep -Fqx "$SOURCE_LINE" "$BASHRC" 2>/dev/null; then
    echo "  ✓ Bash integration already added to ~/.bashrc."
else
    printf '\n%s\n' "$SOURCE_LINE" >> "$BASHRC"
    echo "  ✓ Bash integration added to ~/.bashrc."
fi

echo
echo "Pine setup complete!"
echo
echo "Open a new terminal to load the changes."
echo "Or run:"
echo
echo "  source ~/.bashrc"
