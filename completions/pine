_pine() {
    local cur prev commands pine_path commands_dir

    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    pine_path="$(readlink -f "$(command -v pine)" 2>/dev/null)"
    commands_dir="$(dirname "$pine_path")/commands"

    if [ -d "$commands_dir" ]; then
        commands=$(
            find "$commands_dir" -maxdepth 1 -type f -printf '%f\n' |
            sort
        )
    fi

    case "$prev" in
        edit|help)
            COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
            ;;
        *)
            COMPREPLY=( $(compgen -W "help $commands" -- "$cur") )
            ;;
    esac
}

complete -F _pine pine
